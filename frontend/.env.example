# ──────────────────────────────────────────────────────────────────────────────
# MTC Chain Frontend 환경변수 설정 가이드
# 이 파일을 .env.local 로 복사하여 실제 값으로 채우세요.
# .env.local 은 .gitignore에 포함되어 있으므로 절대 Git에 커밋하지 마세요.
# ──────────────────────────────────────────────────────────────────────────────

# ── 스마트 컨트랙트 ─────────────────────────────────────────────────────────────
# Phase 6: Sepolia 배포 후 실제 컨트랙트 주소로 교체
# Etherscan Sepolia에서 확인: https://sepolia.etherscan.io
VITE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# ── Pinata IPFS ─────────────────────────────────────────────────────────────────
# MTC PDF 업로드에 사용 (쓰기 전용 제한 키 권장)
# 발급: https://app.pinata.cloud/keys → "New Key" → "pinFileToIPFS" 권한만 체크
VITE_PINATA_API_KEY=
VITE_PINATA_API_SECRET=

# IPFS 게이트웨이 (PDF 다운로드 · 검증 · 미리보기 URL)
# 기본: Pinata 공개 게이트웨이 (무료, 느릴 수 있음)
# 대안: https://cloudflare-ipfs.com/ipfs  또는  https://ipfs.io/ipfs
VITE_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs

# ── Cloudflare Workers API ──────────────────────────────────────────────────────
# Phase 7: Workers 배포 후 실제 URL로 교체
# wrangler deploy 후 출력된 URL 형식: https://mtc-api.{ACCOUNT_ID}.workers.dev
VITE_WORKERS_API_URL=https://mtc-api.YOUR_ACCOUNT.workers.dev

# Workers POST 엔드포인트 인증 키 (임의 문자열, worker의 WORKERS_API_KEY와 동일)
# worker/wrangler.toml에서 wrangler secret put WORKERS_API_KEY 로 설정한 값
VITE_WORKERS_API_KEY=
