# ──────────────────────────────────────────────────────────────────────────────
# MTC Chain 환경변수 예시
# 이 파일을 복사하여 .env (Hardhat) 또는 frontend/.env.local (Frontend) 로 사용
# .env / .env.local 은 .gitignore에 포함되어 있으므로 절대 커밋하지 마세요
# ──────────────────────────────────────────────────────────────────────────────

# ── Hardhat / Sepolia 배포 (루트 .env) ────────────────────────────────────────

# Sepolia RPC URL (Alchemy / Infura / 공개 RPC)
# 예: https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# 배포 지갑 개인키 (0x 포함 64자)
# 절대 실제 자산이 있는 지갑 사용 금지 — Sepolia 테스트 전용
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Etherscan API 키 (소스코드 Verify용)
# https://etherscan.io/myapikey 에서 발급
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# 가스 리포트 활성화 (선택)
REPORT_GAS=false

# ── Frontend 환경변수 (frontend/.env.local) ────────────────────────────────────

# 배포된 MtcRegistry 컨트랙트 주소 (Phase 6 이후 설정)
VITE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Pinata IPFS 업로드 API 키 (https://app.pinata.cloud/keys)
# 쓰기 전용 제한 키 사용 권장
VITE_PINATA_API_KEY=YOUR_PINATA_API_KEY
VITE_PINATA_API_SECRET=YOUR_PINATA_API_SECRET

# IPFS 게이트웨이 (PDF 다운로드용)
VITE_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs

# Cloudflare Workers API URL (Phase 7 이후 설정)
VITE_WORKERS_API_URL=https://mtc-api.YOUR_ACCOUNT.workers.dev

# Workers 쓰기 보호용 시크릿 키 (임의 문자열 생성)
VITE_WORKERS_API_KEY=YOUR_WORKERS_SECRET_KEY
